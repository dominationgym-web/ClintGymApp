# Copy to .env and fill in. Never commit the real .env file.

# Supabase project (Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# UUID of the single trainer's auth.users row (single-trainer launch only).
# Client self-signup writes this as clients.trainer_id. Once there is more
# than one trainer, replace this with server-side trainer assignment.
EXPO_PUBLIC_DEFAULT_TRAINER_ID=

# Video storage (Phase 1 video upload) - pick one, wire up when implementing uploads
# EXPO_PUBLIC_MUX_ENV_KEY=
# EXPO_PUBLIC_CLOUDFLARE_STREAM_ACCOUNT_ID=

# Server-side only (Supabase Edge Functions), never prefix with EXPO_PUBLIC_ or ship in the app bundle:
# ANTHROPIC_API_KEY=            # Phase 5 AI insight layer
# SUPABASE_SERVICE_ROLE_KEY=    # scheduled functions (auto-delete videos, expiry reminders)
