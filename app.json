{
  "expo": {
    "name": "Daily Evolution",
    "description": "Total Lifestyle Training & Accountability",
    "slug": "consistent-change",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "consistentchange",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dominationgym.consistentchange",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "G9H9FAB4WS",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.dominationgym.consistentchange"
        ]
      }
    },
    "android": {
      "package": "com.dominationgym.consistentchange",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#080808"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_IMAGES",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you pick a training video, progress photo or profile photo from your library to send to your coach.",
          "cameraPermission": "Lets you record training videos and take progress and profile photos for your coach.",
          "microphonePermission": "Records sound with your training videos."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Lets trainers bring their client sessions in from the phone's calendar into Live sessions. Nothing is changed in your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4AF37"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Checks which country you're in once, when you apply as a trainer, so you're charged the right prices. Only your country is saved."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Reads the workouts from your watch (runs, rides, walks, swims and more), with their distance and heart rate, your sleep and your daily steps, so your coach can see them and plan your training.",
          "NSHealthUpdateUsageDescription": "Daily Evolution only reads your workouts, sleep and steps. It never writes or changes anything in Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lets you open Daily Evolution with Face ID, so your training, money and client details stay private."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TrainerCalendar",
              "label": "Today's sessions",
              "description": "Your 1 on 1 sessions still to come today. Tap a name to open it.",
              "minWidth": "110dp",
              "minHeight": "180dp",
              "targetCellWidth": 2,
              "targetCellHeight": 3,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "600dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withNoDuplicateLocation",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Connects to your heart rate chest strap or watch so the app can show your live heart rate and guide you into your training zone."
        }
      ]
    ],
    "owner": "grizzly75",
    "extra": {
      "eas": {
        "projectId": "6da3ee24-30c4-4bc4-962c-ccbdff4ad4c8"
      }
    },
    "runtimeVersion": "2026-10-26-sound",
    "updates": {
      "url": "https://u.expo.dev/6da3ee24-30c4-4bc4-962c-ccbdff4ad4c8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
