{
  "expo": {
    "name": "Daily Grizz",
    "description": "Total Lifestyle Training & Accountability",
    "slug": "daily-grizz",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "dailygrizz",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dominationgym.dailygrizz",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dominationgym.dailygrizz",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": ["CAMERA", "READ_MEDIA_VIDEO", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you pick a training video, progress photo or profile photo from your library to send to your coach.",
          "cameraPermission": "Lets you record training videos and take progress and profile photos for your coach.",
          "microphonePermission": "Records sound with your training videos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#22C55E"
        }
      ]
    ]
  }
}
