{
  "expo": {
    "name": "Daily Evolution",
    "description": "Total Lifestyle Training & Accountability",
    "slug": "consistent-change",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "consistentchange",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dominationgym.consistentchange",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dominationgym.consistentchange",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#080808"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_IMAGES",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you pick a training video, progress photo or profile photo from your library to send to your coach.",
          "cameraPermission": "Lets you record training videos and take progress and profile photos for your coach.",
          "microphonePermission": "Records sound with your training videos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4AF37"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Checks which country you're in once, when you apply as a trainer, so you're charged the right prices. Only your country is saved."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Reads the workouts from your watch (runs, rides, walks, swims and more), with their distance and heart rate, and your sleep, so your coach can see them and plan your training.",
          "NSHealthUpdateUsageDescription": "Daily Evolution only reads your workouts and sleep. It never writes or changes anything in Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "owner": "grizzly75",
    "extra": {
      "eas": {
        "projectId": "6da3ee24-30c4-4bc4-962c-ccbdff4ad4c8"
      }
    },
    "runtimeVersion": "2026-10-26-sound",
    "updates": {
      "url": "https://u.expo.dev/6da3ee24-30c4-4bc4-962c-ccbdff4ad4c8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
